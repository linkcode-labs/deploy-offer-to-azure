{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "Global Profile Page: a self-service account page for users of Azure AD B2C or Entra External ID, running on Azure Container Apps.",
        "location": {
          "label": "Region",
          "toolTip": "Region of the Container Apps environment and the other regional resources.",
          "resourceTypes": [
            "Microsoft.App/managedEnvironments"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "name",
        "type": "Microsoft.Common.TextBox",
        "label": "Name prefix",
        "constraints": {
          "required": true,
          "regex": "^[a-z0-9][a-z0-9-]{1,10}[a-z0-9]$",
          "validationMessage": "Use 3 to 12 lowercase letters, digits or hyphens, not starting or ending with a hyphen."
        },
        "defaultValue": "gpp",
        "toolTip": "Prefix of every resource name, 3 to 12 lowercase letters, digits or hyphens."
      }
    ],
    "steps": [
      {
        "name": "image",
        "label": "Application image",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.InfoBox",
            "options": {
              "icon": "Info",
              "text": "Use the image reference and the registry token you received from LinkCode."
            }
          },
          {
            "name": "containerImage",
            "type": "Microsoft.Common.TextBox",
            "label": "Image",
            "constraints": {
              "required": true,
              "regex": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+(:[A-Za-z0-9._-]+|@sha256:[a-f0-9]{64})$",
              "validationMessage": "Enter a full image reference: registry/repository:tag."
            },
            "toolTip": "For example linkcode.azurecr.io/com-cis-global-profile-page:1.0.0."
          },
          {
            "name": "registryUsername",
            "type": "Microsoft.Common.TextBox",
            "label": "Registry token name",
            "constraints": {
              "required": false
            },
            "toolTip": "Empty only for a public image."
          },
          {
            "name": "registryPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Registry token password"
            },
            "options": {
              "hideConfirmation": true
            },
            "constraints": {
              "required": false
            },
            "visible": "[not(empty(steps('image').registryUsername))]"
          }
        ]
      },
      {
        "name": "identity",
        "label": "Sign-in",
        "elements": [
          {
            "name": "identityProvider",
            "type": "Microsoft.Common.DropDown",
            "label": "Identity provider",
            "defaultValue": "Entra External ID",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "Entra External ID",
                  "value": "EntraExternalId"
                },
                {
                  "label": "Azure AD B2C",
                  "value": "AzureAdB2C"
                }
              ]
            }
          },
          {
            "name": "azureAdInstance",
            "type": "Microsoft.Common.TextBox",
            "label": "Authority host",
            "constraints": {
              "required": true,
              "regex": "^https://[^\\s]+/$",
              "validationMessage": "Enter an https URL ending with /."
            },
            "toolTip": "For example https://contoso.ciamlogin.com/ or https://contoso.b2clogin.com/."
          },
          {
            "name": "azureAdDomain",
            "type": "Microsoft.Common.TextBox",
            "label": "Tenant domain",
            "constraints": {
              "required": true
            },
            "toolTip": "For example contoso.onmicrosoft.com."
          },
          {
            "name": "azureAdTenantId",
            "type": "Microsoft.Common.TextBox",
            "label": "Tenant id",
            "constraints": {
              "required": true,
              "regex": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
              "validationMessage": "Enter a GUID."
            }
          },
          {
            "name": "azureAdClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "Web sign-in client id",
            "constraints": {
              "required": true,
              "regex": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
              "validationMessage": "Enter a GUID."
            },
            "toolTip": "App registration with redirect URI https://<app host>/signin-oidc."
          },
          {
            "name": "azureAdClientSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Web sign-in client secret"
            },
            "options": {
              "hideConfirmation": true
            },
            "constraints": {
              "required": true
            }
          },
          {
            "name": "azureAdSignUpSignInPolicyId",
            "type": "Microsoft.Common.TextBox",
            "label": "Sign-up/sign-in policy",
            "constraints": {
              "required": true
            },
            "toolTip": "For example B2C_1A_SignUpSignIn.",
            "visible": "[equals(steps('identity').identityProvider, 'AzureAdB2C')]"
          }
        ]
      },
      {
        "name": "graph",
        "label": "Microsoft Graph",
        "elements": [
          {
            "name": "info",
            "type": "Microsoft.Common.InfoBox",
            "options": {
              "icon": "Info",
              "text": "App registration in the identity provider tenant with the application permissions User.ReadWrite.All, UserAuthenticationMethod.ReadWrite.All and AuditLog.Read.All."
            }
          },
          {
            "name": "graphTenantId",
            "type": "Microsoft.Common.TextBox",
            "label": "Tenant id",
            "constraints": {
              "required": true,
              "regex": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
              "validationMessage": "Enter a GUID."
            }
          },
          {
            "name": "graphClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "Client id",
            "constraints": {
              "required": true,
              "regex": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
              "validationMessage": "Enter a GUID."
            }
          },
          {
            "name": "graphClientSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Client secret"
            },
            "options": {
              "hideConfirmation": true
            },
            "constraints": {
              "required": true
            }
          },
          {
            "name": "ropcTokenEndpoint",
            "type": "Microsoft.Common.TextBox",
            "label": "ROPC token endpoint",
            "constraints": {
              "required": true
            },
            "toolTip": "B2C only: token endpoint of the user flow that checks the current password.",
            "visible": "[equals(steps('identity').identityProvider, 'AzureAdB2C')]"
          },
          {
            "name": "ropcClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "ROPC client id",
            "constraints": {
              "required": true,
              "regex": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
              "validationMessage": "Enter a GUID."
            },
            "visible": "[equals(steps('identity').identityProvider, 'AzureAdB2C')]"
          }
        ]
      },
      {
        "name": "options",
        "label": "Options",
        "elements": [
          {
            "name": "stepUpRequiredClaimValue",
            "type": "Microsoft.Common.TextBox",
            "label": "Step-up required claim value",
            "constraints": {
              "required": false
            },
            "toolTip": "Empty: step-up authentication is off."
          },
          {
            "name": "stepUpClaimType",
            "type": "Microsoft.Common.TextBox",
            "label": "Step-up claim type",
            "constraints": {
              "required": false
            },
            "defaultValue": "acr",
            "visible": "[not(empty(steps('options').stepUpRequiredClaimValue))]"
          },
          {
            "name": "stepUpB2CPolicy",
            "type": "Microsoft.Common.TextBox",
            "label": "Step-up B2C policy",
            "constraints": {
              "required": false
            },
            "visible": "[and(equals(steps('identity').identityProvider, 'AzureAdB2C'), not(empty(steps('options').stepUpRequiredClaimValue)))]"
          },
          {
            "name": "stepUpAuthenticationContextId",
            "type": "Microsoft.Common.TextBox",
            "label": "Step-up authentication context id",
            "constraints": {
              "required": false
            },
            "toolTip": "Entra External ID: Conditional Access authentication context, for example c1.",
            "visible": "[and(equals(steps('identity').identityProvider, 'EntraExternalId'), not(empty(steps('options').stepUpRequiredClaimValue)))]"
          },
          {
            "name": "googleClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "Google client id",
            "constraints": {
              "required": false
            },
            "toolTip": "Turns Google account linking on. Redirect URI: https://<app host>/bff/link/google/callback."
          },
          {
            "name": "googleClientSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Google client secret"
            },
            "options": {
              "hideConfirmation": true
            },
            "constraints": {
              "required": false
            },
            "visible": "[not(empty(steps('options').googleClientId))]"
          },
          {
            "name": "smsSenderType",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "SMS sender",
            "defaultValue": "None (set later)",
            "toolTip": "Phone verification sends codes from Azure Communication Services. A phone number has a monthly fee; an alphanumeric sender ID (for example the company name) has none but must be enabled in ACS and is only supported in some countries, Poland included. Recipients cannot reply to it.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "None (set later)",
                  "value": "none"
                },
                {
                  "label": "Phone number",
                  "value": "number"
                },
                {
                  "label": "Alphanumeric sender ID",
                  "value": "alphanumeric"
                }
              ],
              "required": true
            }
          },
          {
            "name": "smsSenderNumber",
            "type": "Microsoft.Common.TextBox",
            "label": "SMS sender number",
            "constraints": {
              "required": true,
              "regex": "^\\+[1-9][0-9]{6,14}$",
              "validationMessage": "Enter a number in E.164 format, for example +48123456789."
            },
            "toolTip": "Phone number bought in Azure Communication Services.",
            "visible": "[equals(steps('options').smsSenderType, 'number')]"
          },
          {
            "name": "smsSenderId",
            "type": "Microsoft.Common.TextBox",
            "label": "SMS sender ID",
            "constraints": {
              "required": true,
              "regex": "^(?=.*[A-Za-z])[A-Za-z0-9 ]{1,11}$",
              "validationMessage": "Use 1-11 letters, digits or spaces, with at least one letter, for example CIS."
            },
            "toolTip": "Alphanumeric sender ID enabled in Azure Communication Services (Phone numbers, Alphanumeric sender ID).",
            "visible": "[equals(steps('options').smsSenderType, 'alphanumeric')]"
          },
          {
            "name": "enableRedis",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "Redis cache",
            "defaultValue": "On",
            "toolTip": "Azure Managed Redis shares verification codes and token caches between replicas. Without it the app runs as one replica and pending codes are lost on restart or scale to zero.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "On",
                  "value": "on"
                },
                {
                  "label": "Off (one replica, lower cost)",
                  "value": "off"
                }
              ],
              "required": true
            }
          },
          {
            "name": "minReplicas",
            "type": "Microsoft.Common.Slider",
            "label": "Minimum replicas",
            "min": 0,
            "max": 10,
            "defaultValue": 1,
            "showStepMarkers": false,
            "toolTip": "0 scales to zero when idle: cheapest, with a cold start of a few seconds on the next request."
          },
          {
            "name": "maxReplicas",
            "type": "Microsoft.Common.Slider",
            "label": "Maximum replicas",
            "min": 1,
            "max": 30,
            "defaultValue": 5,
            "showStepMarkers": false,
            "visible": "[equals(steps('options').enableRedis, 'on')]"
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "name": "[basics('name')]",
      "containerImage": "[steps('image').containerImage]",
      "registryUsername": "[steps('image').registryUsername]",
      "registryPassword": "[coalesce(steps('image').registryPassword, '')]",
      "identityProvider": "[steps('identity').identityProvider]",
      "azureAdInstance": "[steps('identity').azureAdInstance]",
      "azureAdDomain": "[steps('identity').azureAdDomain]",
      "azureAdTenantId": "[steps('identity').azureAdTenantId]",
      "azureAdClientId": "[steps('identity').azureAdClientId]",
      "azureAdClientSecret": "[steps('identity').azureAdClientSecret]",
      "azureAdSignUpSignInPolicyId": "[if(equals(steps('identity').identityProvider, 'AzureAdB2C'), steps('identity').azureAdSignUpSignInPolicyId, '')]",
      "graphTenantId": "[steps('graph').graphTenantId]",
      "graphClientId": "[steps('graph').graphClientId]",
      "graphClientSecret": "[steps('graph').graphClientSecret]",
      "ropcTokenEndpoint": "[if(equals(steps('identity').identityProvider, 'AzureAdB2C'), steps('graph').ropcTokenEndpoint, '')]",
      "ropcClientId": "[if(equals(steps('identity').identityProvider, 'AzureAdB2C'), steps('graph').ropcClientId, '')]",
      "stepUpClaimType": "[coalesce(steps('options').stepUpClaimType, 'acr')]",
      "stepUpRequiredClaimValue": "[steps('options').stepUpRequiredClaimValue]",
      "googleClientId": "[steps('options').googleClientId]",
      "smsSender": "[if(equals(steps('options').smsSenderType, 'number'), steps('options').smsSenderNumber, if(equals(steps('options').smsSenderType, 'alphanumeric'), steps('options').smsSenderId, ''))]",
      "minReplicas": "[steps('options').minReplicas]",
      "maxReplicas": "[if(equals(steps('options').enableRedis, 'on'), steps('options').maxReplicas, 1)]",
      "stepUpB2CPolicy": "[coalesce(steps('options').stepUpB2CPolicy, '')]",
      "stepUpAuthenticationContextId": "[coalesce(steps('options').stepUpAuthenticationContextId, '')]",
      "googleClientSecret": "[coalesce(steps('options').googleClientSecret, '')]",
      "enableRedis": "[equals(steps('options').enableRedis, 'on')]"
    }
  }
}
